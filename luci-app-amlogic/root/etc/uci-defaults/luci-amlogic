#!/bin/sh

# Patch the CBI post flag only on classic Lua LuCI where the dispatcher file
# exists; back it up first and roll back if the result is not valid Lua, so a
# failed edit can never take the whole web UI down.
dp="/usr/lib/lua/luci/dispatcher.lua"
if [ -f "$dp" ] && grep -q 'cbi.submit"\] = true' "$dp"; then
	cp -f "$dp" "${dp}.amlogic-bak"
	sed -i 's/cbi.submit\"] = true/cbi.submit\"] = \"1\"/g' "$dp"
	if command -v luac >/dev/null 2>&1; then
		luac -p "$dp" 2>/dev/null || cp -f "${dp}.amlogic-bak" "$dp"
	fi
	rm -f "${dp}.amlogic-bak"
fi

# Raise uhttpd max_requests (default 3 is too low for this plugin's concurrent
# polling and can crash some uhttpd builds), but never override a higher value.
cur_max="$(uci -q get uhttpd.main.max_requests 2>/dev/null)"
if [ -z "$cur_max" ] || [ "$cur_max" -lt 50 ] 2>/dev/null; then
	uci -q batch <<-EOF >/dev/null
		set uhttpd.main.max_requests='50'
		commit uhttpd
	EOF
	# Apply now (skip during image build).
	[ -z "${IPKG_INSTROOT}" ] && /etc/init.d/uhttpd reload >/dev/null 2>&1 || true
fi

uci -q batch <<-EOF >/dev/null
	delete ucitrack.@amlogic[-1]
	add ucitrack amlogic
	set ucitrack.@amlogic[-1].init=amlogic
	commit ucitrack
EOF

rm -rf /tmp/luci-*
exit 0
